# OpenELIS Papua New Guinea distro — environment overrides template.
#
# Copy to `.env` and edit only the values you want to override:
#
#     cp .env.example .env
#     # edit as needed
#     docker compose up -d
#
# Every value below is optional — `docker-compose.yml` ships sensible
# defaults (the same ones shown here) so `docker compose up -d` boots a
# healthy localhost-demo stack with no `.env` file at all. Override here for
# production deployments.
#
# `.env` is gitignored. Never commit it.

# --- Application credentials --------------------------------------------
# CHANGE THESE for non-localhost deployments.

# clinlims DB password (Postgres user that owns the OpenELIS schema).
OE_DB_PASSWORD=clinlims

# postgres superuser password (used during DB init only).
ADMIN_PASSWORD=superuser

# OpenELIS in-app admin password.
#
# Used by the analyzer bridge to authenticate its REST forwards, and it is
# the password `scripts/set-admin-password.sh` applies to the in-app `admin`
# account.
#
# !! Setting this alone does NOT change the login password. !!
#
# The admin account is created on first boot from a bcrypt hash baked into
# the webapp image at BUILD time (upstream Dockerfile `ARG DEFAULT_PW` ->
# install/createDefaultPassword.sh -> adminPassword.txt on the WAR
# classpath). A distro that ships pinned upstream images cannot change a
# build argument, so until you run the script below the site accepts the
# published default `admin` / `adminADMIN!` and nothing else.
#
# MANDATORY on every new site, once the stack is up and healthy:
#
#     ./scripts/set-admin-password.sh          # applies the value below
#     ./scripts/set-admin-password.sh --check  # re-verify at any time
#
# The script refuses the published default, enforces the policy below, and
# verifies afterwards that the configured password is accepted and
# `adminADMIN!` is rejected.
#
# Password policy (OpenELIS MinnPasswordValidation — enforced by the UI's
# change-password form as well, so pick a value that satisfies it):
#   - at least 8 characters
#   - ONLY these characters:  A-Z  a-z  0-9  _  %  $  #  !
#     Anything else is rejected. A hyphen '-' is the usual thing that trips
#     people up; '@' and '*' are rejected too.
#   - at least 3 of the 4 classes: lowercase, uppercase, digit, special (%$#!)
#
# Change it again later in the UI (Administration -> Users), and keep this
# value in step — the analyzer bridge authenticates with it.
OE_ADMIN_PASSWORD=adminADMIN!

# --- DB Volume Mount ----------------------------------------------------
# The local directory used to store the database so that its remains
# stable across restarts and is available to be backed-up.
DB_VOLUME_MOUNT=./configs/database/data

# --- Analyzer file-drop host mount --------------------------------------
# Host directory root for analyzer file drops (NFS, USB, network shares).
# Mounted read-only at the same path inside webapp + bridge so admin-typed
# paths in the UI work unchanged.
ANALYZER_HOST_MOUNT=/mnt

# --- TLS material (truststore + keystore paths inside containers) -------
SSL_TRUSTSTORE_PATH=/etc/openelis-global/truststore
SSL_TRUSTSTORE_PASSWORD=tspass
SSL_KEYSTORE_PATH=/etc/openelis-global/keystore
SSL_KEYSTORE_PASSWORD=kspass

# --- Let's Encrypt (only used with compose.letsencrypt.yaml overlay) ----
# Consumed by scripts/generate-letsencrypt-certs.sh and the proxy overlay.
# Leave commented out for localhost demos.
#
# Both the overlay and scripts/generate-letsencrypt-certs.sh read these from
# this file — no need to export them into your shell.
#
# To enable production TLS:
#   1. Uncomment + fill in the values below.
#   2. docker compose -f docker-compose.yml -f compose.letsencrypt.yaml up -d
#   3. ./scripts/generate-letsencrypt-certs.sh --dry-run   # quota-safe check
#   4. ./scripts/generate-letsencrypt-certs.sh             # real issuance
#
# See docs/letsencrypt.md for the full walkthrough.

# LETSENCRYPT_EMAIL=admin@example.com
# LETSENCRYPT_DOMAINS=example.com
# LETSENCRYPT_PRIMARY_DOMAIN=example.com
# LETSENCRYPT_CERT_NAME=example.com

# Make every plain `docker compose` command include the Let's Encrypt overlay.
# Uncomment together with the block above, or a later `docker compose up -d`
# (for example during an upgrade) drops the proxy back to the self-signed cert.
# COMPOSE_FILE=docker-compose.yml:compose.letsencrypt.yaml
