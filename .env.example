# OpenELIS Papua New Guinea distro — environment overrides template.
#
# Copy to `.env` and edit only the values you want to override:
#
#     cp .env.example .env
#     # edit as needed
#     docker compose up -d
#
# Set unique application and database passwords before starting Compose.
# Compose initializes and verifies them before starting the proxy.
#
# `.env` is gitignored. Never commit it.

# --- Application credentials --------------------------------------------
# CHANGE THESE before running the installer.

# clinlims DB password (Postgres user that owns the OpenELIS schema).
OE_DB_PASSWORD=clinlims

# Password for both PostgreSQL privileged accounts (fresh DB initialization).
ADMIN_PASSWORD=superuser

# OpenELIS in-app administrator, initialized once by Compose.
# Changing this after installation does not reset the account; keep it in sync
# with changes made in the application. A mismatch blocks proxy startup.
# Intentional reset: ./scripts/set-admin-password.sh
# Check only:       ./scripts/set-admin-password.sh --check
#
# Policy: at least 8 characters, only A-Z a-z 0-9 _ % $ # !,
# with at least three of lowercase, uppercase, digit and special character.
# Use single quotes around values containing $ so Compose preserves it literally.
OE_ADMIN_PASSWORD=adminADMIN!

# --- DB Volume Mount ----------------------------------------------------
# The local directory used to store the database so that its remains
# stable across restarts and is available to be backed-up.
DB_VOLUME_MOUNT=./configs/database/data

# --- Analyzer file-drop host mount --------------------------------------
# Optional: leave these unset for analyzers connected over the network.
# Enable only for instruments that deliver files to a host directory.
# Create the directory first; it is mounted read-only in webapp + bridge
# at /data/analyzer-drops. See README "File-based analyzers".
# Append compose.analyzer-files.yaml to your existing COMPOSE_FILE if set.
# COMPOSE_FILE=docker-compose.yml:compose.analyzer-files.yaml
# ANALYZER_HOST_MOUNT=./configs/analyzer-drops

# HTTP-based instruments use the Bridge HTTPS port (8442 on the host).
# Leave local-only unless needed; then bind to the server's lab-network IP
# and restrict access to configured instruments with the site firewall.
# BRIDGE_HTTPS_BIND_ADDRESS=192.0.2.10

# --- Installation TLS stores -----------------------------------------
# Passwords remain configurable and are used by the generator and consumers.
# Set them before first installation; changing them does not rotate existing stores.
# Keep these paths for the standard PNG volume layout.
# Stored-field encryption uses a separate generated secret, not these passwords.
SSL_TRUSTSTORE_PATH=/etc/openelis-global/truststore
SSL_TRUSTSTORE_PASSWORD=tspass
SSL_KEYSTORE_PATH=/etc/openelis-global/keystore
SSL_KEYSTORE_PASSWORD=kspass

# --- Let's Encrypt (only used with compose.letsencrypt.yaml overlay) ----
# Consumed by scripts/generate-letsencrypt-certs.sh and the proxy overlay.
# Leave commented out for localhost demos.
#
# Both the overlay and scripts/generate-letsencrypt-certs.sh read these from
# this file — no need to export them into your shell.
#
# To enable production TLS:
#   1. Uncomment + fill in the values below.
#   2. docker compose -f docker-compose.yml -f compose.letsencrypt.yaml up -d
#   3. ./scripts/generate-letsencrypt-certs.sh --dry-run   # quota-safe check
#   4. ./scripts/generate-letsencrypt-certs.sh             # real issuance
#
# See docs/letsencrypt.md for the full walkthrough.

# LETSENCRYPT_EMAIL=admin@example.com
# LETSENCRYPT_DOMAINS=example.com
# LETSENCRYPT_PRIMARY_DOMAIN=example.com
# LETSENCRYPT_CERT_NAME=example.com

# Make every plain `docker compose` command include the Let's Encrypt overlay.
# Uncomment together with the block above, or a later `docker compose up -d`
# (for example during an upgrade) drops the proxy back to the self-signed cert.
# COMPOSE_FILE=docker-compose.yml:compose.letsencrypt.yaml

# --- High availability (optional; see scripts/ha/README.md) --------------
# Streaming-replication failover across servers. Every server in the
# cluster needs the SAME OE_DB_PASSWORD / ADMIN_PASSWORD / OE_ADMIN_PASSWORD.
# COMPOSE_FILE=docker-compose.yml:compose.ha.yaml
# HA_NODE=site-a
# HA_MEMBERS="offsite=10.88.0.1 site-a=10.88.0.2,192.168.1.10 site-b=10.88.0.3,192.168.1.11"
# HA_PG_BIND_WG=10.88.0.2
# HA_PG_BIND_LAN=192.168.1.10
# HA_REPLICATION_PASSWORD=change-me
