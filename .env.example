# OpenELIS Papua New Guinea distro: environment template.
#
#     cp .env.example .env
#     # edit as needed
#     docker compose up -d
#
# docker-compose.yml ships defaults for everything, so a localhost demo boots
# after setting the three site passwords below. Defaults are refused.
# `.env` is gitignored. Never commit it.

# --- Which compose files make up this stack -------------------------------
# Core + Analyzer Bridge. Add compose.letsencrypt.yaml for a public HTTPS
# certificate, compose.ha.yaml for failover, docker-compose.site.yml for this
# server's own overrides (see docker-compose.site.yml.example).
COMPOSE_FILE=docker-compose.yml:docker-compose.analyzers.yml

# --- Where this site's data lives -----------------------------------------
# Database, Analyzer Bridge state, uploads, logs and internal TLS material.
# Back this directory up; everything else can be re-cloned.
DATA_ROOT=./data

# --- Application credentials (CHANGE for every real site) -----------------
# clinlims DB password (Postgres user that owns the OpenELIS schema).
OE_DB_PASSWORD=
# postgres superuser password (used at database creation only).
ADMIN_PASSWORD=

# Applied once on a fresh database and verified before the proxy starts.
# Later starts do not reset a password changed in the UI. Keep .env in sync.
# At least 8 characters, letters/digits/_%$#!, with three character classes.
OE_ADMIN_PASSWORD=

# The initializer creates DATA_ROOT/tls/stores/encryption.key once.
# Back it up with the database. It is independent of TLS passwords and must
# never be replaced to make an existing database start. Old-data upgrade is
# separate; this fresh target does not discover or convert historical keys.

# --- Analyzer Bridge ------------------------------------------------------
# One-time code OpenELIS and the Bridge pair with on first start (same value
# for both containers). Generate one per site:  openssl rand -hex 16
# The merged application also recovers a stale pairing with a valid code.
# Migrating data and identities from another installation remains separate.
ANALYZER_BRIDGE_PAIRING_CODE=
# Host port of the shared ASTM listener every TCP analyzer connects to.
ANALYZER_ASTM_PORT=12000
# For instruments, bind the server LAN address and list their source IPs/CIDRs.
# Connection host/sender routing does not configure listener admission.
ANALYZER_LISTEN_ADDRESS=127.0.0.1
ANALYZER_ALLOWED_SOURCES=127.0.0.1/32
# Analyzer types offered for setup. Default: the PNG set in
# configs/analyzer-catalog. The Bridge's built-in types instead:
# BRIDGE_SHIPPED_PROFILES=classpath*:/analyzer-profiles/**/*.json
# Bridge log level (INFO; DEBUG or TRACE to follow ASTM framing).
BRIDGE_LOG_LEVEL=INFO
# Host directory root for analyzer file drops (NFS, USB, shares), read-only.
# ANALYZER_HOST_MOUNT=/absolute/existing/directory
# Add compose.analyzer-files.yaml to COMPOSE_FILE only for FILE analyzers.

# --- Site behaviour -------------------------------------------------------
TZ=Pacific/Port_Moresby
# Load the PNG catalog CSVs (configs/configuration/backend) at startup. Set
# false on a site whose catalog is managed in the database, for example one
# migrated from an older stack, so the baseline is not imported over it.
OE_CONFIGURATION_AUTOCREATE=true
# Address the webapp, FHIR and Bridge API ports bind to (behind the proxy).
LOCAL_BIND=127.0.0.1

# --- Internal TLS (between services; browsers use the proxy certificate) --
# The init service generates this site's own certificate and stores under
# DATA_ROOT/tls on first start, protected with these passwords.
SSL_TRUSTSTORE_PATH=/etc/openelis-global/truststore
SSL_TRUSTSTORE_PASSWORD=tspass
SSL_KEYSTORE_PATH=/etc/openelis-global/keystore
SSL_KEYSTORE_PASSWORD=kspass

# --- Let's Encrypt (with compose.letsencrypt.yaml) ------------------------
# See docs/letsencrypt.md. Either this distro's script issues the certificate
# (defaults below), or a certbot already on the host does: then point
# LETSENCRYPT_DIR and CERTBOT_WEBROOT at its directories.
# LETSENCRYPT_EMAIL=admin@example.com
# LETSENCRYPT_DOMAINS=example.com
# LETSENCRYPT_PRIMARY_DOMAIN=example.com
# LETSENCRYPT_CERT_NAME=example.com
# LETSENCRYPT_DIR=./configs/letsencrypt
# CERTBOT_WEBROOT=./configs/nginx/certbot
# COMPOSE_FILE=docker-compose.yml:docker-compose.analyzers.yml:compose.letsencrypt.yaml

# --- High availability (optional; see scripts/ha/README.md) ---------------
# Every server in the cluster needs the SAME OE_DB_PASSWORD / ADMIN_PASSWORD /
# OE_ADMIN_PASSWORD and the retained installation encryption key.
# COMPOSE_FILE=docker-compose.yml:docker-compose.analyzers.yml:compose.ha.yaml
# HA_NODE=site-a
# HA_MEMBERS="offsite=10.88.0.1 site-a=10.88.0.2,192.168.1.10 site-b=10.88.0.3,192.168.1.11"
# HA_PG_BIND_WG=10.88.0.2
# HA_PG_BIND_LAN=192.168.1.10
# HA_REPLICATION_PASSWORD=change-me

# Optional read-only credentials for private GHCR metadata packages.
# Keep credentials in the deployment environment or an untracked .env, never a pin.
CONFIGURATION_REGISTRY_USERNAME=
CONFIGURATION_REGISTRY_TOKEN=
