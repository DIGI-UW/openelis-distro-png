# Local secrets and env (do not commit credentials)
.env
.env.letsencrypt
.env.local
.env.*.local
# Copies of an older .env kept while moving a site
.env.pre-migration-*

# Locally-built release tarballs (scripts/build-tarball.sh output).
openelis-png-distro-*.tar.gz

# Local compose files. The canonical tracked compose lives at
# docker-compose.yml; compose.yaml + the override files are local
# test-harness state with :local image pins and machine-specific
# paths — never commit these.
compose.yaml
docker-compose.site.yml
compose.override.yaml
compose.override.yml
docker-compose.override.yml

# Runtime data (DATA_ROOT): database, bridge state, uploads, logs, TLS.
/data/

# Pre-data-root layout, kept ignored for older checkouts
configs/bridge-state/

# scripts/backup.sh output — database dumps and a copy of .env
backups/

# Database bind mounts and local OE config overrides
configs/logs/
configs/logs/*
configs/database/data*/
**/*checksum*.properties
**/*checksums*.properties
configs/properties/TotalSystemConfiguration.properties
configs/properties/ChangedSystemConfiguration.properties

# Runtime TLS / ACME material (generated; keep .gitkeep placeholders only)
configs/letsencrypt/live/
configs/letsencrypt/archive/
configs/letsencrypt/renewal/
configs/letsencrypt/accounts/
volume/letsencrypt/live/
volume/letsencrypt/archive/
volume/letsencrypt/renewal/
volume/letsencrypt/accounts/
volume/letsencrypt-staging/
volume/letsencrypt-staging-logs/

# Node and Playwright
node_modules/
test-results/
playwright-report/
blob-report/
**/playwright/.auth/

# CI and local validation artifacts
test-artifacts/

# IDE and OS
.cursor/
.claude/
.idea/
.DS_Store

# HA state (scripts/ha): FENCED marker, standby-since
configs/ha/

# Local branch checkouts and Python test caches
.worktrees/
__pycache__/

# Downloaded metadata installed by the pinned-package initializer.
configs/configuration/backend/*/pkg--*
